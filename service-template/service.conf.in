# __NAME__
#   Browser:  https://${__VAR___SERVER_NAME}:__PORT__
#   Upstream: ${__VAR___UPSTREAM}  (joined to stile_net under that alias)
#
# Generated by add-service.sh. Values come from .env. Edit freely; this is
# yours now. Rendered at container start.

server {
    listen __PORT__ ssl default_server;
    server_name _;
    include /etc/nginx/snippets/https-listener.conf;
    include /etc/nginx/conf.d/tls/__NAME__.inc;
    return 421;
}

server {
    listen __PORT__ ssl;
    server_name ${__VAR___SERVER_NAME};
    include /etc/nginx/snippets/https-listener.conf;
    include /etc/nginx/conf.d/tls/__NAME__.inc;

    client_max_body_size ${__VAR___MAX_BODY};
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        set $upstream ${__VAR___UPSTREAM};
        proxy_pass __SCHEME__://$upstream;
__UPSTREAM_TLS__        include /etc/nginx/snippets/proxy.conf;
    }
}
