# Stile settings. Copy to .env and edit:
#
#     cp .env.example .env
#
# Nothing in here is a secret. The certificates and the CA key live in the
# stile_state volume, not in this file.
#
# Restart after any change:  docker compose up -d --force-recreate

# Name shown on the local CA certificate when it is first created.
PROXY_CA_NAME="Stile Local CA"

# Docker network the projects join. Must match STILE_NETWORK in each
# project's .env if you change it (the default is the same on both sides).
PROXY_NETWORK=stile_net

# ─── Per service ──────────────────────────────────────────────────────────────
# <NAME>_SERVER_NAME  What users type in the browser. Space-separated for more
#                     than one (e.g. "cairn.example.org 192.168.1.50"). Keep it
#                     matching SERVER_NAME / BASE_URL in that project's own .env.
# <NAME>_UPSTREAM     Container alias and port on the stile_net network. The
#                     alias is set in the project's docker-compose.nginx.yml.
# <NAME>_HTTPS_PORT   Host port users connect to.
# <NAME>_MAX_BODY     Largest request body (upload) nginx passes through.

# CAIRN. Upstream port is PORT in cairn/.env.
CAIRN_SERVER_NAME=localhost
CAIRN_UPSTREAM=cairn-web:5000
CAIRN_HTTPS_PORT=7443
# Keep at or above MAX_UPLOAD_MB in cairn/.env.
CAIRN_MAX_BODY=512m

# Skerry. Upstream port is PORT in skerry/.env.
SKERRY_SERVER_NAME=localhost
SKERRY_UPSTREAM=skerry-web:5000
SKERRY_HTTPS_PORT=8443
SKERRY_MAX_BODY=100m

# Plumb. Upstream port is PLUMB_PORT (6443 unless you changed it).
PLUMB_SERVER_NAME=localhost
PLUMB_UPSTREAM=plumb:6443
PLUMB_HTTPS_PORT=6443

# >>> added services (add-service.sh appends here)
